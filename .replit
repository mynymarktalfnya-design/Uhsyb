modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
DB_NAME = "market_db"
JWT_SECRET_KEY = "minimarket-super-secret-jwt-key-2026-secure"
JWT_ALGORITHM = "HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = "1440"
CORS_ORIGINS = "*"
SECRET_KEY = "minimarket-super-secret-jwt-key-2026-secure"
"Model API Key" = "al-Pf1ea92Yrj_0dohJlk9kED6U-TnF-NhbAFw2QZzitJh"

[userenv.development]
ALLOW_MONGOMOCK = "true"

[userenv.production]
ALLOW_MONGOMOCK = "false"

[nix]
channel = "stable-25_05"
packages = ["cacert", "cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]
