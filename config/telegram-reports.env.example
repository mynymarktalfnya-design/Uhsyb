# Copy to config/telegram-reports.env on the Windows machine.
# Never commit the copied file with real values.
TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather
TELEGRAM_CHAT_ID=replace-with-authorized-chat-id
TELEGRAM_ALLOWED_CHAT_IDS=replace-with-authorized-chat-ids
# Use the production adapter configured for this installation.
MONGO_URL=replace-with-production-mongodb-url
DB_NAME=market_db
REPORTS_TIMEZONE=Asia/Aden
ALLOW_MONGOMOCK=false
