# Copy to /etc/mabna-market/telegram-monitor.env and chmod 600.
# Never commit the real token.
TELEGRAM_BOT_TOKEN=replace-with-a-new-token-from-BotFather
TELEGRAM_CHAT_ID=8227840392
CHECK_INTERVAL_SECONDS=60
STATE_FILE=/var/lib/mabna-market/connectivity-state.json
CHECK_URL=https://www.google.com/generate_204
