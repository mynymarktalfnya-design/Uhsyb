[Unit]
Description=Mabna Market Telegram Reports Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=%h/Uhsyb
EnvironmentFile=/etc/mabna-market/telegram-reports.env
ExecStart=/usr/bin/python3 %h/Uhsyb/scripts/telegram_reports_bot.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
